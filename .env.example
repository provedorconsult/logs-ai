# Infraestrutura & Acesso (Tailnet)
TEST_SERVER_HOST=100.x.x.x
TEST_SERVER_USER=clovis
TEST_SERVER_SSH_KEY_PATH=~/.ssh/id_ed25519_logs_ai

# Dokploy API & Deploy
# Usar somente com túnel SSH validado para a porta 3000 do servidor.
# Alternativa: HTTPS com certificado e hostname validados, aprovado pelo responsável.
DOKPLOY_URL=http://127.0.0.1:13000
DOKPLOY_API_TOKEN=substitua_pelo_token_dokploy
DOKPLOY_PROJECT_ID=substitua_pelo_project_id
# Exceção HTTP Tailnet: habilitar somente por autorização humana explícita.
DOKPLOY_ALLOW_TAILNET_HTTP=false
DOKPLOY_TAILNET_HTTP_ORIGIN=http://servidor.exemplo.ts.net:3000
DOKPLOY_API_CONTRACT_VERIFIED=false
DOKPLOY_SSH_TUNNEL_VERIFIED=false
EXPECTED_REVISION=substitua_pelo_sha_completo
# Transporte administrativo explícito: direct em runner com rota própria;
# proxy no runtime gerenciado, fixando a origem aprovada (sem credenciais na URL).
DOKPLOY_TRANSPORT=
DOKPLOY_APPROVED_PROXY=
DOKPLOY_DEPLOYMENT_RECEIPT=work/dokploy-deployment.json
DOKPLOY_DEPLOY_TIMEOUT=600
# Snapshot completo e autoritativo do ambiente Compose, mantido fora do Git, modo 0600.
# Não confundir com o .env de seletores administrativos; não preencher a partir de resposta redigida.
DOKPLOY_ENV_FILE=/caminho/protegido/compose.env

# Aplicação logs-ai (Homologação)
APP_TEST_URL=http://100.x.x.x:8000
DATABASE_URL=postgres://user:password@dokploy-postgres:5432/logs_ai_test

# PostgreSQL dedicado do Compose (gerar valor aleatório, seguro para URL)
POSTGRES_PASSWORD=substitua_por_hex_aleatorio
# Expor apenas em loopback por padrão; usar proxy reverso Dokploy para homologação
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
APP_IMAGE=logs-ai:local
# Recurso Compose previamente configurado no projeto Dokploy
DOKPLOY_COMPOSE_ID=substitua_pelo_compose_id
